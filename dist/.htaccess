# SPA fallback for Hostinger (Apache/LiteSpeed): serve index.html for any
# path that isn't a real file or folder, so deep links like /work and page
# refreshes load the app instead of the host's 404 page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
